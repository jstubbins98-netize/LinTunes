# Local binary package: packageLinux.sh stages an existing CMake build first.
pkgname=lintunes
pkgver=@PROJECT_VERSION@
pkgrel=1
pkgdesc='Music library manager with iPod sync and CD support'
arch=("${CARCH:-@CMAKE_SYSTEM_PROCESSOR@}")
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'gtk3' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good'
         'taglib' 'sqlite' 'libgpod' 'libcdio' 'libcdio-paranoia' 'libcddb'
         'vlc' 'udisks2' 'dosfstools')
optdepends=('gst-libav: additional playback codecs'
            'ffmpeg: AAC conversion and CD burning'
            'lame: MP3 encoding'
            'flac: FLAC encoding'
            'vorbis-tools: OGG encoding'
            'cdrkit: wodim executable for audio-CD burning (may require AUR)'
            'idevicerestore: iPod touch firmware restoration'
            'libimobiledevice: iPod touch identification')
options=('!strip')

package() {
    if [[ -z "${LINTUNES_STAGE_DIR:-}" || ! -x "$LINTUNES_STAGE_DIR/usr/bin/lintunes" ]]; then
        printf '%s\n' 'Run packageLinux.sh --format arch to stage the existing build first.' >&2
        return 1
    fi
    cp -a "$LINTUNES_STAGE_DIR/." "$pkgdir/"
}
