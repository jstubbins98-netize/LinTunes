# Source package for AUR. Generate .SRCINFO with makepkg --printsrcinfo.
# Maintainer: @MAINTAINER@
pkgname=lintunes
pkgver=@VERSION@
pkgrel=1
pkgdesc='GTK music manager with iPod sync, internet radio and CD support'
arch=('x86_64' 'aarch64')
url='@HOMEPAGE@'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'gtk3' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good'
         'taglib' 'sqlite' 'libgpod' 'libcdio' 'libcdio-paranoia' 'libcddb'
         'vlc' 'udisks2' 'dosfstools')
makedepends=('cmake' 'pkgconf')
optdepends=('gst-libav: additional playback codecs'
            'ffmpeg: AAC conversion and CD burning'
            'lame: MP3 encoding'
            'flac: FLAC encoding'
            'vorbis-tools: OGG encoding'
            'cdrkit: wodim for audio-CD burning (may require AUR)'
            'idevicerestore: iPod touch firmware restoration'
            'libimobiledevice: iPod touch identification')
source=("lintunes-${pkgver}.tar.gz::@SOURCE_URL@")
sha256sums=('@SHA256@')

build() {
    cmake -S "$srcdir/lintunes-$pkgver" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
