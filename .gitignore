# Keep only Linux source-release inputs at the top level.
# Generated upload files are still available on disk for dput/GitHub uploads.
# This does not affect files already tracked by Git.
/*
!/.gitignore
!/CMakeLists.txt
!/LICENSE
!/README.md
!/manual.md
!/PUBLISHING.md
!/buildPod.sh
!/packageLinux.sh
!/prepareRelease.py
!/src/
!/resources/
!/cmake/
!/packaging/
!/tests/
# Preserve actual Debian source metadata if packaging is assembled here.
!/debian/

# Build products, including accidental in-source CMake builds.
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Makefile
build.ninja
.ninja_deps
.ninja_log
compile_commands.json
_CPack_Packages/
Testing/
*.o
*.obj
*.a
*.so
*.so.*
*.gcda
*.gcno
*.gcov
__pycache__/
*.py[cod]

# Generated binaries and source-upload artifacts (not packaging templates).
*.deb
*.ddeb
*.rpm
*.pkg.tar.*
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
*.dsc
*.changes
*.buildinfo
*.upload

# Debhelper staging state; keep debian/rules, control, changelog, etc.
/debian/.debhelper/
/debian/lintunes/
/debian/lintunes-dbgsym/
/debian/tmp/
/debian/files
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log
/debian/*.debhelper.*

# Local configuration, credentials, editor state, and backups.
.env
.env.*
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
